def ler_lancamentos():
    cursor.execute("SELECT * FROM LANCAMENTOS")
    registros = cursor.fetchall()
    print("\n--- REGISTROS ---")
    for r in registros:
        print(r)
    print("-----------------\n")

def inserir_lancamento(DATALANCTO, HISTORICO, VALLANCTO):
    sql = """
        INSERT INTO LANCAMENTOS (DATALANCTO, HISTORICO, VALLANCTO)
        VALUES (?, ?, ?)
    """
    cursor.execute(sql, (DATALANCTO, HISTORICO, VALLANCTO))
    conn.commit()
    print("Registro inserido com sucesso.\n")

def atualizar_lancamento(SEQUENCIA, nova_descricao, novo_valor):
    sql = """
        UPDATE LANCAMENTOS
        SET HISTORICO = ?, VALLANCTO = ?
        WHERE SEQUENCIA = ?
    """
    cursor.execute(sql, (nova_descricao, novo_valor, SEQUENCIA))
    conn.commit()
    print("Registro atualizado.\n")

def excluir_varios(sequencias):
    if not sequencias:
        print("\nNenhuma SEQUENCIA informada.\n")
        return

    # Monta a lista de placeholders (?, ?, ?, ...)
    placeholders = ", ".join(["?"] * len(sequencias))

    sql = f"DELETE FROM LANCAMENTOS WHERE SEQUENCIA IN ({placeholders})"

    cursor.execute(sql, sequencias)
    conn.commit()

    print(f"\nRegistros excluídos: {sequencias}\n")

def excluir_faixa_sequencia(seq_ini, seq_fim):
    sql = """
        DELETE FROM LANCAMENTOS
        WHERE SEQUENCIA BETWEEN ? AND ?
    """
    cursor.execute(sql, (seq_ini, seq_fim))
    conn.commit()
    print(f"\nRegistros com SEQUENCIA entre {seq_ini} e {seq_fim} foram excluídos.\n")

def excluir_por_periodo(data_ini, data_fim):
    sql = """
        DELETE FROM LANCAMENTOS
        WHERE DATALANCTO BETWEEN ? AND ?
    """
    cursor.execute(sql, (data_ini, data_fim))
    conn.commit()
    print(f"\nRegistros entre {data_ini} e {data_fim} foram excluídos.\n")

