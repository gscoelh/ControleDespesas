#------------------------------
# dusca por periodo especifivo
#------------------------------
def buscar_por_periodo(data_ini, data_fim):
    sql = """
        SELECT * FROM LANCAMENTOS
        WHERE DATALANCTO BETWEEN ? AND ?
        ORDER BY DATALANCTO
    """
    cursor.execute(sql, (data_ini, data_fim))
    registros = cursor.fetchall()

    print("\n--- RESULTADO DA BUSCA POR PERÍODO ---")
    for r in registros:
        print(r)
    print("--------------------------------------\n")
#-----------------------------------------
# buscar por numero da sequencia
#-----------------------------------------
def buscar_por_sequencia(seq):
    sql = "SELECT * FROM LANCAMENTOS WHERE SEQUENCIA = ?"
    cursor.execute(sql, (seq,))
    registros = cursor.fetchall()

    print("\n--- RESULTADO DA BUSCA POR SEQUENCIA ---")
    for r in registros:
        print(r)
    print("----------------------------------------\n")
# -----------------------------
# define valores em reais
# -----------------------------
def excluir_por_sequencia(sequencia):
    # Verifica se o registro existe antes de excluir
    sql_verifica = "SELECT * FROM LANCAMENTOS WHERE SEQUENCIA = ?"
    cursor.execute(sql_verifica, (sequencia,))
    registro = cursor.fetchone()

    if registro is None:
        print(f"\nNenhum registro encontrado com SEQUENCIA = {sequencia}\n")
        return

    # Exclui o registro
    sql_excluir = "DELETE FROM LANCAMENTOS WHERE SEQUENCIA = ?"
    cursor.execute(sql_excluir, (sequencia,))
    conn.commit()

    print(f"\nRegistro com SEQUENCIA = {sequencia} foi excluído com sucesso.\n")

# -----------------------------
# define valores em reais
# -----------------------------
def converter_valor_brasileiro(valor_str):
    """
    Converte valores no formato brasileiro:
    '1.234,56' -> 1234.56
    '150,75'   -> 150.75
    '200'      -> 200.0
    """
    valor_str = valor_str.replace(".", "")   # remove separador de milhar
    valor_str = valor_str.replace(",", ".")  # troca vírgula por ponto
    return float(valor_str)


